# Required: Gemini API key — get free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: model overrides
PLANNER_MODEL=gemma-4-31b-it
REVIEWER_MODEL=gemma-4-31b-it

# Required for Phase 6: Telegram bot — get via @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated user IDs (find via @userinfobot). Empty = dev mode (anyone can chat)
TELEGRAM_AUTHORIZED_USERS=

# Optional for Phase 8: Tavily web search — get free 1000/mo at https://tavily.com
TAVILY_API_KEY=
